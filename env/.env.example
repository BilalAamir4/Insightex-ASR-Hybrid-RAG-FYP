# Variables the project reads. The canonical values are set by env/insightex_env.sh;
# this file documents them. Uncommented lines are set inside WSL; commented lines are Windows-side.

# Repo checkout (code, config, docs).
INSIGHTEX_HOME=$HOME/insightex
# Runtime data outside the repo (db, eval data, logs, workspaces).
INSIGHTEX_DATA=$HOME/insightex-data
#   $INSIGHTEX_DATA/lectures/<lecture_id>/  ingested lectures (video.mp4, audio.wav, thumbnail.jpg, manifest.json);
#                                           config key paths.lectures. .locks/ holds per-lecture ingest locks.
#   $INSIGHTEX_DATA/logs/ingest/ingest.log  full ingestion error log written by the ingest CLI.
# Master model cache on the Windows drive (copy source for ~/cache; never point runtime caches here).
INSIGHTEX_MODEL_CACHE_MASTER=/mnt/e/FYP/cache
# Runtime HuggingFace cache on ext4 (fast loads).
HF_HOME=$HOME/cache/huggingface
# Keep HuggingFace offline; set to 0 only for an approved model download.
HF_HUB_OFFLINE=1
# Windows-host Ollama endpoint, reached from WSL via mirrored networking.
OLLAMA_BASE_URL=http://localhost:11434
# Pip wheel cache on ext4.
PIP_CACHE_DIR=$HOME/cache/pip
# PyTorch cache on ext4.
TORCH_HOME=$HOME/cache/torch
# /usr/lib/wsl/lib plus the nvidia-* lib dirs of ~/envs/insightex (needed by faster-whisper); built with dedup by the env script.
LD_LIBRARY_PATH=<computed by env/insightex_env.sh>

# Windows user environment: where Ollama stores models. Not set in WSL.
# OLLAMA_MODELS=E:\FYP\LLMs
# Set in scripts/windows/start_ollama.ps1: loopback only, never 0.0.0.0.
# OLLAMA_HOST=127.0.0.1:11434
